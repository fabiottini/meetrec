<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>meetrec-capture</AssemblyName>
    <RootNamespace>MeetRec.Capture</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- published into the same folder as MeetRec.exe: they share the .NET runtime files there.
         A separate exe on purpose: an app that starts itself again from the user profile is reported
         by antivirus heuristics (Avira: ...UserProfileSelfRun) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationIcon>..\app\MeetRec.ico</ApplicationIcon>
    <!-- shown in the file properties; unsigned files without them look more suspicious to antivirus heuristics -->
    <Product>MeetRec</Product>
    <Company>MeetRec (open source, github.com/fabiottini/meetrec)</Company>
    <Copyright>MIT License, Fabio Lucattini</Copyright>
    <FileDescription>MeetRec recorder (microphone and system audio)</FileDescription>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
